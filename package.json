{
  "name": "animoku",
  "version": "1.0.0",
  "private": true,
  "description": "Self-hosted Plex metadata provider for anime: AniList matching, TVDB-aligned seasons, episode titles from TMDB and AniDB, extra artwork from Fanart.tv.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VincentVS/AniMoku.git"
  },
  "keywords": [
    "plex",
    "plex-metadata-provider",
    "metadata",
    "anime",
    "anilist",
    "anidb",
    "tmdb",
    "fanart",
    "self-hosted"
  ],
  "license": "MIT",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/VincentVS/AniMoku/issues"
  },
  "homepage": "https://github.com/VincentVS/AniMoku#readme",
  "dependencies": {
    "express": "^5.3.0",
    "pino": "^9.5.0"
  }
}
