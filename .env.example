# Copy this file to .env (which is gitignored) and adjust as needed.

# Docker image docker-compose runs. Defaults to the latest release; use a version
# tag (ghcr.io/vincentvs/animoku:1.0.0) to pin one, :edge for the main branch,
# or animoku:local for an image you built yourself.
# ANIMOKU_IMAGE=ghcr.io/vincentvs/animoku:latest

# The container runs unprivileged as this uid/gid: ./data must be writable by it.
PUID=1000
PGID=1000

# Priority order for show titles: AniList's english / romaji / native fields, and
# localized - the library language's title from TMDB's translations (needs TMDB
# credentials; non-English libraries only). Comma-separated; any key you omit is
# appended after the ones you listed, so a list without localized puts it last.
TITLE_LANGUAGE_ORDER=localized,english,romaji,native

# Set to absolute when files keep absolute episode numbers inside season folders
# (Sonarr's S02.E21 with {absolute} as the episode): an ambiguous index is then read
# as absolute rather than season-relative.
# FILE_NUMBERING=absolute

# Optional: personal Fanart.tv API key (free, sign up at https://fanart.tv/get-an-api-key/).
# When set, the /images endpoint supplements AniList's single poster/background with
# extra posters, backgrounds, a clear logo, and a square background from Fanart.tv
# (looked up via a TheTVDB id crosswalk, so coverage depends on that show having a
# TVDB entry). Leave unset to keep using AniList's images only.
FANART_API_KEY=

# Optional: TMDB credentials (free, sign up at https://www.themoviedb.org/settings/api).
# When set, /library/metadata/matches also searches TMDB alongside AniList, so
# non-anime titles that AniList has no entry for (Western cartoons like Rick and
# Morty, live-action shows, etc.) can still be matched and served. Leave both unset
# to keep using AniList only.
#
# TMDB issues two credentials together; either one works (same access level) -
# set whichever you prefer, TMDB_ACCESS_TOKEN takes priority if both are set.
# "API Key" (v3 auth, sent as an api_key query param):
TMDB_API_KEY=
# "API Read Access Token" (v4 auth, sent as an Authorization: Bearer header):
TMDB_ACCESS_TOKEN=

# Log verbosity for the pino logger: trace, debug, info, warn, error, fatal.
LOG_LEVEL=info

# How long (in seconds) AniList/TMDB/Fanart.tv responses are cached in memory before
# being re-fetched. Plex frequently calls metadata/children/grandchildren/images
# back-to-back for the same entry; caching cuts down on repeat calls and on hitting
# AniList's rate limiting. Set to 0 to disable caching entirely. Defaults to 600 (10
# minutes) if unset.
METADATA_CACHE_TTL_SECONDS=600

# Episode numbering Plex is told to expect for anime matched from now on:
#   tvdb      S03E13 style, seasons as TVDB/Sonarr split them (default)
#   absolute  every regular episode in season 1, S01E103 style (what HAMA + Absolute
#             Series Scanner did); specials stay in season 0
# A single show can override it with a "[absolute]" or "[tvdb]" tag in its folder
# name. Shows already matched keep their order until re-matched (Fix Match).
EPISODE_ORDER=tvdb

# Optional: AniDB episode titles/summaries/air dates (in many languages, long runners
# included). Register a client (free) at https://anidb.net/software/add with an AniDB
# account and put its name and version here. Leave unset to disable AniDB.
# AniDB bans clients that request too often: responses are cached on disk in
# CACHE_DIR (mount it as a volume!) and refreshed at most once a day while airing,
# once a week afterwards.
ANIDB_CLIENT=
ANIDB_CLIENTVER=
# Seconds between AniDB requests (minimum 2, AniDB's own limit).
ANIDB_MIN_INTERVAL_SECONDS=4
# Longest a Plex request waits for AniDB; a slower fetch finishes in the background
# and is used on the next refresh.
ANIDB_WAIT_SECONDS=10

# AniList queue: minimum milliseconds between requests (~30/min, AniList's degraded
# limit), and the longest Retry-After waited out before failing fast instead.
ANILIST_MIN_INTERVAL_MS=2000
ANILIST_MAX_RETRY_WAIT_SECONDS=30
# Where persistent caches live (defaults to ./data/cache).
CACHE_DIR=./data/cache
