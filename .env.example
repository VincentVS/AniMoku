# Copy this file to .env (which is gitignored) and adjust as needed.

# Docker image tag docker-compose should run. See docker-publish.local.md
# for the build/push commands that produce these tags.
ANIME_PROVIDER_IMAGE=<DOCKERHUB_USER>/<REPO_NAME>:anime-metadata-provider-latest

# Priority order for AniList's title.english / title.romaji / title.native fields,
# used for show/season/episode titles. Comma-separated; any key you omit is appended
# after the ones you listed. AniList has no Italian title field, so "it" is not a valid key.
TITLE_LANGUAGE_ORDER=english,romaji,native

# Optional: personal Fanart.tv API key (free, sign up at https://fanart.tv/get-an-api-key/).
# When set, the /images endpoint supplements AniList's single poster/background with
# extra posters, backgrounds, a clear logo, and a square background from Fanart.tv
# (looked up via a TheTVDB id crosswalk, so coverage depends on that show having a
# TVDB entry). Leave unset to keep using AniList's images only.
FANART_API_KEY=

# Optional: TMDB credentials (free, sign up at https://www.themoviedb.org/settings/api).
# When set, /library/metadata/matches also searches TMDB alongside AniList, so
# non-anime titles that AniList has no entry for (Western cartoons like Rick and
# Morty, live-action shows, etc.) can still be matched and served. Leave both unset
# to keep using AniList only.
#
# TMDB issues two credentials together; either one works (same access level) -
# set whichever you prefer, TMDB_ACCESS_TOKEN takes priority if both are set.
# "API Key" (v3 auth, sent as an api_key query param):
TMDB_API_KEY=
# "API Read Access Token" (v4 auth, sent as an Authorization: Bearer header):
TMDB_ACCESS_TOKEN=

# Log verbosity for the pino logger: trace, debug, info, warn, error, fatal.
LOG_LEVEL=info
